# === Telegram ===
TELEGRAM_BOT_TOKEN=

# === OpenVPN (gluetun custom) ===
# Положите файл конфига сюда: ./vpn/custom.ovpn
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=openvpn
OPENVPN_CUSTOM_CONFIG=/gluetun/custom.ovpn

# Если в .ovpn нет auth или логин/пароль отдельно:
OPENVPN_USER=
OPENVPN_PASSWORD=

# Бот ходит в Telegram напрямую.
# Сайт КЕП — через HTTP-прокси gluetun (см. KEP_HTTP_PROXY в docker-compose.yml).

# Опционально: если провайдер требует
# OPENVPN_PROTOCOL=udp
# OPENVPN_CIPHER=AES-256-GCM
